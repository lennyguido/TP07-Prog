@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="registro">
    <h1>Iniciar sesión</h1>

    @if (ViewBag.Error != null)
    {
        <p class="error">@ViewBag.Error</p>
    }

    <form action='@Url.Action("IniciarSesion", "Home")' method="POST">
        <h2>Nombre de Usuario:</h2>
        <input class="registro-control" type="text" name="nombreUsuario" id="nombreUsuario" required />

        <h2>Contraseña:</h2>
        <input class="registro-control" type="password" name="contrasena" id="contrasena" required />

        <button type="submit">Entrar</button>
        <button type="reset">Resetear</button>
    </form>

    <p>¿No tenés cuenta? <a href="@Url.Action("Registrarse", "Home")">Registrate</a></p>
</section>
