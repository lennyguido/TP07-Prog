<header>
    <nav>
 
        <ul>
    <li><a href="@Url.Action("Index", "Home")">Inicio</a></li>
    <li><a href="@Url.Action("IniciarSesion", "Home")">Iniciar sesion</a></li>
    <li><a href="@Url.Action("Registrarse", "Home")">Registrarse</a></li>
</ul>
    </nav>
</header>
<main class="registro">
    <h1>Iniciar sesión</h1>

    @if (ViewBag.Error != null)
    {
        <p>@ViewBag.Error</p>
    }

    <form method="post">
        <div>
            <h2>Nombre de Usuario:</h2>
            <input class="registro-control" type="text" name="nombreUsuario" required>
        </div>

        <div>
            <h2>Contraseña:</h2>
            <input class="registro-control" type="password" name="contrasena" required>
        </div>

        <div>
            <button type="submit">Entrar</button>
        </div>
    </form>

    <p>¿No tenés cuenta? <a href="@Url.Action("Registrarse", "Home")">Registrate</a></p>
</main>