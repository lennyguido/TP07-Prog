@model Nueva_carpeta.Models.Usuario

@{
    ViewData["Title"] = "Registrarse";
}

<main class="registro auth-card">
<h1>Registro de usuario</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}


<form id="formRegistro" method="post" onsubmit="return validarRegistro()">
        <div>
        <label for="nombreUsuario">Nombre de usuario</label>
        <input class="registro-control" type="text" name="nombreUsuario" id="nombreUsuario" required>
    </div>

    <div>
        <label for="contrasena">Contraseña</label>
        <input class="registro-control" type="password" name="contrasena" id="contrasena" required>
    </div>

    <div>
        <label for="nombre">Nombre</label>
        <input class="registro-control" type="text" name="nombre" id="nombre" required>
    </div>

    <div>
        <label for="apellido">Apellido</label>
        <input class="registro-control" type="text" name="apellido" id="apellido" required>
    </div>

    <div>
        <label for="tipoUsuario">Tipo de usuario</label>
        <select class="registro-control" name="tipoUsuario" id="tipoUsuario" required>
            <option value="">Seleccione un tipo</option>
            <option value="Alumno">Alumno</option>
            <option value="Docente">Docente</option>
            <option value="Coordinador">Coordinador</option>
            <option value="Padre">Padre</option>
        </select>
    </div>

    <div>
        <button type="submit">Registrarse</button>
        <button type="reset">Resetear</button>
    </div>
</form>
</main>