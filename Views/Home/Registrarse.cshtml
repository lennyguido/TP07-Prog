@{
    ViewData["Title"] = "Registrarse";
}

<section class="registro">
    <h1>Registro de Usuario</h1>

    <p class="error" id="errorRegistro">@ViewBag.Error</p>

    <form action='@Url.Action("Registrarse", "Home")' method="POST" onsubmit="return validarRegistro()">
        <h2>Nombre de Usuario (mínimo 4 caracteres):</h2>
        <input class="registro-control" type="text" name="NombreUsuario" id="nombreUsuario" maxlength="50" required />

        <h2>Contraseña (mínimo 6 caracteres):</h2>
        <input class="registro-control" type="password" name="Contrasena" id="contrasena" maxlength="50" required />

        <h2>Nombre:</h2>
        <input class="registro-control" type="text" name="Nombre" id="nombre" maxlength="50" required />

        <h2>Apellido:</h2>
        <input class="registro-control" type="text" name="Apellido" id="apellido" maxlength="50" required />

        <h2>Tipo de Usuario:</h2>
        <select class="registro-control" name="TipoUsuario" id="tipoUsuario" required>
            <option value="">Seleccione un tipo</option>
            <option value="Alumno">Alumno</option>
            <option value="Docente">Docente</option>
            <option value="Coordinador">Coordinador</option>
            <option value="Padre">Padre</option>
        </select>

        <button type="submit">Registrarse</button>
        <button type="reset">Resetear</button>
    </form>
</section>
