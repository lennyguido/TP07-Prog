<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nueva_carpeta</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Nueva_carpeta.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav">
            <a class="brand" href="@Url.Action("Index", "Home")">Red Social</a>
            <div class="nav-links">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                @if (Context.Session.GetString("UsuarioLogueado") == null)
                {
                    <a href="@Url.Action("IniciarSesion", "Home")">Iniciar sesión</a>
                    <a href="@Url.Action("Registrarse", "Home")">Registrarse</a>
                }
                else
                {
                    <span class="nav-user">@Context.Session.GetString("NombreUsuarioLogueado")</span>
                    <a href="@Url.Action("CerrarSesion", "Home")">Cerrar sesión</a>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
